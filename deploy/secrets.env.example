# Шаблон ПРОД-секретів для автономної Windows-машини.
# Скопіювати як  %LOCALAPPDATA%\BMS\secrets.env  і заповнити реальними значеннями.
# Лаунчер (main.py) читає цей файл ПЕРШИМ — він має пріоритет над проєктним .env
# і не лежить поряд з .exe, тож переживає оновлення застосунку.
#
# ⚠️ НІКОЛИ не комітити заповнений файл у git. Тут лише плейсхолдери.

# ── База даних ──────────────────────────────────────────────────────────────
# Для автономного вузла з вбудованим PostgreSQL (deploy/embedded_db.py) host/port
# керує лаунчер; пароль має збігатися з тим, що задає embedded_db при initdb.
DB_NAME=bsstorage
DB_USER=postgres
DB_PASSWORD=<встанови_надійний_пароль>
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_ARCHIVE_CHAT=

# ── Google Sheets ───────────────────────────────────────────────────────────
GOOGLE_SHEETS_JSON_KEY=
GOOGLE_SHEETS_DOCUMENT_NAME_ORDERS=
GOOGLE_SHEETS_DOCUMENT_NAME=
GOOGLE_SHEETS_DOCUMENT_NAME_PRODUCTS=

# ── Cloudflare R2 (фото) ────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Neon: БЮДЖЕТ $3/міс + жорсткий запобіжник (ЖОРСТКЕ ПРАВИЛО, див. CLAUDE.md) ──
# Neon Console → Account settings → API keys. Ключ потрібен З ПРАВОМ ЗАПИСУ: на 90%
# бюджету BMS вимикає compute-ендпоінти (база не прокинеться), доки ви не натиснете
# «Дозволити ще $1». Запити до API — control plane, хмарну БД вони не будять.
NEON_API_KEY=
NEON_PROJECT_ID=plain-breeze-73014199
NEON_PLAN=launch
NEON_BUDGET_USD=3
# NEON_HARD_CAP=1   NEON_PRICE_CU_HOUR=0.106   NEON_PRICE_STORAGE_GB_MONTH=0.35
# NEON_BUDGET_WARN=0.6   NEON_BUDGET_ECONOMY=0.75   NEON_BUDGET_STOP=0.9

# ── OLX (опційно) ───────────────────────────────────────────────────────────
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_REDIRECT_URI=
OLX_SCOPE=
